<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- HealthKit 읽기(Apple Watch 심박 / Garmin Connect 동기화분).
	     ⚠️ 이 파일만으로는 적용되지 않는다. Xcode에서
	     Runner 타겟 → Signing & Capabilities → "+ Capability" → HealthKit 을 추가하면
	     CODE_SIGN_ENTITLEMENTS 빌드 설정이 이 파일을 가리키게 된다.
	     (pbxproj를 손으로 편집하지 않기 위해 파일만 미리 만들어 둔다.) -->
	<key>com.apple.developer.healthkit</key>
	<true/>
	<key>com.apple.developer.healthkit.access</key>
	<array/>
	<!-- ── 푸시 알림(APNs / FCM, PRD §5.10) ────────────────────────────
	     ⚠️ 이 파일만으로는 적용되지 않는다. HealthKit과 같은 절차다 —
	     Xcode에서 Runner 타겟 → Signing & Capabilities → "+ Capability" →
	     Push Notifications 를 추가해야 프로비저닝 프로파일에 APNs가 포함된다.
	     값은 개발 빌드 `development`, TestFlight/App Store 빌드 `production`.
	     Xcode가 빌드 구성에 맞춰 이 값을 덮어쓰므로 여기서는 개발 기본값을 둔다.
	     추가로 Apple Developer 콘솔에서 **APNs 인증 키(.p8)를 발급해 Firebase
	     콘솔에 업로드**해야 한다. 이것이 없으면 iOS에는 푸시가 전혀 가지 않는다. -->
	<key>aps-environment</key>
	<string>development</string>
</dict>
</plist>

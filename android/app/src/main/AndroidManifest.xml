<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- ── 네트워크 ────────────────────────────────────────────────────
         debug/profile 매니페스트에만 있던 INTERNET을 main으로 올렸다.
         릴리즈 빌드에는 병합되지 않아 지도 타일·Supabase 요청이 전부
         막힌다(디버그에서는 멀쩡해 보여 놓치기 쉬운 함정).
         ACCESS_NETWORK_STATE는 네이버 지도 SDK가 오프라인 판정에 쓴다. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>

    <!-- ── 지도 (flutter_naver_map / PRD §7) ───────────────────────────
         ⚠️ NCP Client ID는 여기 meta-data가 아니라 **Dart에서** 넘긴다 —
         `lib/core/map/naver_map_config.dart`의 `initializeNaverMap()`이
         `FlutterNaverMap().init(clientId: ...)`로 네이티브 SDK를 초기화한다
         (1.3.1+ 신규 NCP 인증 방식). 매니페스트에 키를 심어도 읽지 않으므로
         중복 선언하지 말 것. 최소 SDK 23은 `app/build.gradle.kts` 참조. -->

    <!-- ── 위치 (features/tracking) ────────────────────────────────────
         COARSE/FINE는 포그라운드 위치. BACKGROUND는 Android 10(API 29)+에서
         분리된 별도 권한으로, GeolocatorRunTrackingService가 "앱 사용 중" 승인
         이후에만 2단계로 요청한다. 거부돼도 포그라운드 트래킹은 계속된다. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION"/>

    <!-- 화면이 꺼진 상태에서 위치 콜백을 유지하려면 포그라운드 서비스가 필수다.
         Android 14(API 34)부터는 서비스 타입별 권한을 따로 선언해야 한다. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION"/>
    <!-- geolocator의 ForegroundNotificationConfig가 띄우는 상시 알림용(API 33+).
         FCM 푸시(PRD §5.10)도 같은 권한을 쓴다 — 요청 시점은 **첫 러닝 완료
         직후**이며(`notification_permission_primer.dart`), 위치 권한 흐름과
         분리돼 있다. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <uses-permission android:name="android.permission.WAKE_LOCK"/>
    <!-- 배터리 최적화 예외 요청(BatteryOptimizationGuard, PRD TR-02).
         포그라운드 서비스만으로는 샤오미/화웨이 등 OEM 전력 관리가 화면 꺼짐
         수십 분 뒤 서비스를 재워 기록이 끊긴다. "항상 허용" 위치 권한까지 받은
         뒤 **딱 한 번** 시스템 다이얼로그를 띄운다.
         ⚠️ Play 정책상 이 권한은 핵심 기능이 백그라운드 지속 실행을 요구하는
         앱(피트니스 트래킹 등)만 허용된다 — 스토어 등록 시 용도 설명 필요. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"/>

    <!-- ── Health Connect (Garmin/Wear OS 심박) ────────────────────────
         HealthWearableMetricsSource는 READ만 한다. 미설치 기기에서는
         ensureAuthorized()가 false를 돌려주고 폰 단독 트래킹으로 폴백한다. -->
    <uses-permission android:name="android.permission.health.READ_HEART_RATE"/>

    <!-- 위치 하드웨어가 없는 기기(태블릿 등)도 설치는 가능해야 한다. -->
    <uses-feature android:name="android.hardware.location.gps" android:required="false"/>

    <application
        android:label="runnit"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- 카카오 OAuth 콜백 딥링크 복귀 (lib/core/auth/auth_config.dart 와 동일 스킴 유지) -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="io.runnit.app" android:host="login-callback"/>
            </intent-filter>
            <!-- Health Connect가 권한 화면에서 "이 앱이 왜 필요한지" 링크를 띄울 때
                 호출하는 진입점. 없으면 일부 기기에서 권한 요청이 반려된다. -->
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE"/>
            </intent-filter>
        </activity>
        <activity-alias
            android:name="ViewPermissionUsageActivity"
            android:exported="true"
            android:targetActivity=".MainActivity"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE"/>
                <category android:name="android.intent.category.HEALTH_PERMISSIONS"/>
            </intent-filter>
        </activity-alias>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- Health Connect 설치 여부 조회. package visibility(API 30+) 때문에
             선언하지 않으면 health 플러그인이 항상 "미설치"로 판단한다. -->
        <package android:name="com.google.android.apps.healthdata"/>
    </queries>
</manifest>
